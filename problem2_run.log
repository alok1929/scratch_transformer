# 0. Environment and reproducibility
import os, math, time, random, urllib.request, zipfile, io, gc, copy, json
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import TensorDataset, DataLoader

SEED = 42
random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)
if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("PyTorch:", torch.__version__)
print("Device:", DEVICE)
if DEVICE.type == "cuda":
    print("GPU:", torch.cuda.get_device_name(0))
# Problem 2 experiment config (match Problem 1 protocol where applicable)
FIG_DIR = Path("figures")
FIG_DIR.mkdir(parents=True, exist_ok=True)
P2_HAR_SEEDS = [7, 21, 42]
HAR_EPOCHS = 20
HAR_BATCH = 128
HAR_CLIP = 1.0
LM_EPOCHS = 60
LM_BATCHES_PER_EPOCH = 300
LM_LR = 1e-3
LM_WARMUP_STEPS = 200
HEAD_ABLATION_EPOCHS = None  # defaults to LM_EPOCHS when None
HEAD_ABLATION_BATCHES = None

# Set P2_FAST_DEV=1 for a short smoke run (2 epochs) before the full overnight train.
if os.environ.get("P2_FAST_DEV") == "1":
    HAR_EPOCHS, LM_EPOCHS, LM_BATCHES_PER_EPOCH = 2, 2, 50
    P2_HAR_SEEDS = [42]

def save_fig(filename):
    out = FIG_DIR / filename
    plt.savefig(out, dpi=150, bbox_inches="tight")
    print("saved", out)

from sklearn.metrics import f1_score

def macro_f1_score(y_true, y_pred, num_classes=6):
    return float(f1_score(y_true, y_pred, labels=list(range(num_classes)), average="macro"))

