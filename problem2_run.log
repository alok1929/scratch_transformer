# Hand-checkable example (single head, d_k=1)
q_small = torch.tensor([[[[1.0], [0.0], [-1.0]]]])
k_small = torch.tensor([[[[1.0], [0.0], [-1.0]]]])
v_small = torch.tensor([[[[10.0], [20.0], [30.0]]]])

scores_small = torch.matmul(q_small, k_small.transpose(-2, -1))  # sqrt(d_k)=1
out_small, weights_small = scaled_dot_product_attention(q_small, k_small, v_small)
print("Scores:\n", scores_small[0, 0])
print("Attention weights:\n", weights_small[0, 0])
print("Output:\n", out_small[0, 0])
expected_w = torch.tensor([[0.6652, 0.2447, 0.0900],
                           [0.0900, 0.2447, 0.6652],
                           [0.0900, 0.0900, 0.8200]])
# row 1 output ~14.25 for the printed hand example
assert torch.allclose(weights_small[0, 0], expected_w[0], atol=1e-3)
assert torch.allclose(out_small[0, 0, 0], torch.tensor(14.25), atol=0.1)
print("Hand-check asserts passed (instructor example assumed; document in report).")

